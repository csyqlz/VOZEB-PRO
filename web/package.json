        "@playwright/test": "1.62.1",
        "@tailwindcss/postcss": "^4",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^20",
        "@types/pg": "^8.20.3",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "eslint": "9.39.5",
        "eslint-config-next": "16.2.12",
        "jsonrepair": "^3.15.0",
        "postcss": "8.5.25",
        "prettier": "^3.9.6",
        "shadcn": "^4.16.1",
        "typescript": "^5",
        "vitest": "^4.1.10"
