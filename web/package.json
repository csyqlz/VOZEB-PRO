        "@tanstack/react-query": "^5.101.4",
        "antd": "^6.5.3",
        "axios": "^1.19.0",
        "clsx": "^2.1.1",
        "copy-to-clipboard": "^4.0.2",
        "dayjs": "^1.11.20",
        "fflate": "^0.8.3",
        "file-saver": "^2.0.5",
        "file-type": "^22.0.1",
        "jsjianyingdraft": "1.0.0",
        "lucide-react": "^1.28.0",
        "motion": "^12.43.0",
        "nanoid": "^6.0.0",
        "next": "16.2.12",
        "parse5": "8.0.1",
        "pg": "^8.22.0",
        "radix-ui": "^1.6.7",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "sharp": "0.35.3",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.4.0",
        "undici": "^8.9.0",
        "yaml": "^2.8.1",
        "zustand": "^5.0.12"
