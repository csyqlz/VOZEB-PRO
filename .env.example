# VOZEB PRO deployment environment
# Docker: copy this file to .env in the repository root.
# Source development: copy it to web/.env.local and change DATABASE_URL host to localhost.

# Required public URL. Production should use the externally reachable HTTPS origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional image override. The default Compose release is pinned; use vozeb-pro:local when building on the server.
VOZEB_PRO_IMAGE=ghcr.io/csyqlz/vozeb-pro:v0.0.7

# Default Docker Compose creates this PostgreSQL database and overrides DATABASE_URL with host `postgres`.
POSTGRES_DB=vozeb_pro
POSTGRES_USER=vozeb_pro
POSTGRES_PASSWORD=

# Source deployment and external PostgreSQL connection.
VOZEB_PRO_DATABASE_PROVIDER=postgres
DATABASE_URL=
VOZEB_PRO_DATABASE_POOL_MAX=10
# Local/Docker PostgreSQL normally uses 0. Managed cloud PostgreSQL commonly requires 1.
VOZEB_PRO_DATABASE_SSL=0
# TLS verification defaults to enabled. Only set 0 for a provider that cannot supply a trusted certificate.
VOZEB_PRO_DATABASE_SSL_REJECT_UNAUTHORIZED=1
# Optional PEM CA certificate. In single-line env files encode line breaks as \n.
VOZEB_PRO_DATABASE_SSL_CA=

# Optional PostgreSQL-only tenant dashboard MVP. Keep disabled until schema and backups are verified.
VOZEB_PRO_TENANT_MVP_ENABLED=false

# Optional DeepSeek text fallback. When no backend default text model is configured,
# setting this key creates an environment-backed default text model automatically.
VOZEB_PRO_DEEPSEEK_API_KEY=
VOZEB_PRO_DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
VOZEB_PRO_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional SiliconFlow image fallback. When no backend default image model is configured,
# setting this key creates an environment-backed default image model automatically.
# Cheapest default is Kwai-Kolors/Kolors; set Qwen/Qwen-Image only when you prefer quality over cost.
VOZEB_PRO_SILICONFLOW_API_KEY=
VOZEB_PRO_SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors
VOZEB_PRO_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Required in production. Must be 64 hexadecimal characters or exact 32-byte Base64.
# Generate once with `openssl rand -hex 32`, keep it stable, and never commit the real value.
VOZEB_PRO_ENCRYPTION_KEY=

# Required only until the first administrator is created. Use at least 32 random characters.
# Generate with `openssl rand -hex 32`; keep it server-side and remove it after installation completes.
VOZEB_PRO_INSTALL_TOKEN=

# Runtime paths and internal callbacks.
VOZEB_PRO_DATA_DIR=/app/web/.data
VOZEB_PRO_INTERNAL_ORIGIN=http://127.0.0.1:3000
# Leave empty for automatic HTTP/HTTPS detection. Set true or false only for unusual proxies.
VOZEB_PRO_COOKIE_SECURE=
# Reverse proxy hop count used for rate limiting client IPs. Set 1 for one trusted proxy.
VOZEB_PRO_TRUSTED_PROXY_HOPS=0
# Optional local override when FFmpeg is not on PATH. Docker images already include FFmpeg.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional outbound proxy used by server-side model/provider requests.
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=

# Private or loopback model providers are blocked by default. Enable only for administrator-controlled hosts.
# Hosts are exact, comma-separated names or IP addresses; do not add cloud metadata or link-local addresses.
VOZEB_PRO_ALLOW_PRIVATE_UPSTREAMS=0
VOZEB_PRO_PRIVATE_UPSTREAM_HOSTS=

# Billing behavior.
VOZEB_PRO_BILLING_ORDER_EXPIRES_MINUTES=30
# Optional token for deployment-neutral maintenance jobs. Use at least 32 random characters.
# Generate with `openssl rand -hex 32`, then call maintenance APIs with `Authorization: Bearer <token>`.
VOZEB_PRO_MAINTENANCE_TOKEN=
# Required by the generation Worker and internal per-user task callbacks. It must differ from the maintenance token.
VOZEB_PRO_WORKER_TOKEN=
# Worker polls the internal endpoint. Docker Compose sets this to http://app:3000.
VOZEB_PRO_WORKER_API_ORIGIN=
VOZEB_PRO_GENERATION_WORKER_ID=
# Initial idle polling interval. Consecutive empty batches back off to 10000ms.
VOZEB_PRO_GENERATION_WORKER_INTERVAL_MS=2000
VOZEB_PRO_GENERATION_WORKER_LANES=2
VOZEB_PRO_GENERATION_WORKER_HEARTBEAT_MS=15000
VOZEB_PRO_GENERATION_WORKER_STALE_MS=90000

# Optional work-publication moderation signal provider. Signals never auto-approve content.
# manual: always requires an administrator review (default).
# keywords: checks the comma/newline-separated keyword list below.
# http: POSTs public draft fields to the configured endpoint with a 3-second timeout.
VOZEB_PRO_CONTENT_MODERATION_PROVIDER=manual
VOZEB_PRO_CONTENT_MODERATION_KEYWORDS=
VOZEB_PRO_CONTENT_MODERATION_URL=
VOZEB_PRO_CONTENT_MODERATION_API_KEY=

# Optional Stripe configuration. It can also be saved from the admin payment settings page.
VOZEB_PRO_STRIPE_SECRET_KEY=
VOZEB_PRO_STRIPE_WEBHOOK_SECRET=
VOZEB_PRO_STRIPE_API_BASE=https://api.stripe.com
VOZEB_PRO_STRIPE_SUCCESS_URL=
VOZEB_PRO_STRIPE_CANCEL_URL=
VOZEB_PRO_STRIPE_PAYMENT_METHOD_TYPES=
VOZEB_PRO_STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Optional Alipay configuration.
VOZEB_PRO_ALIPAY_MODE=official
VOZEB_PRO_ALIPAY_APP_ID=
VOZEB_PRO_ALIPAY_PRIVATE_KEY=
VOZEB_PRO_ALIPAY_PRIVATE_KEY_PATH=
VOZEB_PRO_ALIPAY_PUBLIC_KEY=
VOZEB_PRO_ALIPAY_PUBLIC_KEY_PATH=
VOZEB_PRO_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
VOZEB_PRO_ALIPAY_NOTIFY_URL=
VOZEB_PRO_ALIPAY_RETURN_URL=

# Optional WeChat Pay v3 configuration.
VOZEB_PRO_WECHAT_PAY_APP_ID=
VOZEB_PRO_WECHAT_PAY_MCH_ID=
VOZEB_PRO_WECHAT_PAY_CERT_SERIAL_NO=
VOZEB_PRO_WECHAT_PAY_PRIVATE_KEY=
VOZEB_PRO_WECHAT_PAY_PRIVATE_KEY_PATH=
VOZEB_PRO_WECHAT_PAY_API_V3_KEY=
VOZEB_PRO_WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=
VOZEB_PRO_WECHAT_PAY_PLATFORM_PUBLIC_KEY=
VOZEB_PRO_WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
VOZEB_PRO_WECHAT_PAY_PLATFORM_CERTIFICATE=
VOZEB_PRO_WECHAT_PAY_PLATFORM_CERTIFICATE_PATH=
VOZEB_PRO_WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
VOZEB_PRO_WECHAT_PAY_NOTIFY_URL=
VOZEB_PRO_WECHAT_PAY_REFUND_NOTIFY_URL=
VOZEB_PRO_WECHAT_PAY_WEBHOOK_TOLERANCE_SECONDS=300

# Optional PayPly/custom gateway configuration.
VOZEB_PRO_PAYPLY_CHECKOUT_URL=
VOZEB_PRO_PAYPLY_REFUND_URL=
VOZEB_PRO_PAYPLY_API_KEY=
VOZEB_PRO_PAYPLY_API_KEY_HEADER=
VOZEB_PRO_PAYPLY_MERCHANT_ID=
VOZEB_PRO_PAYPLY_REQUEST_METHOD=POST
VOZEB_PRO_PAYPLY_CONTENT_TYPE=application/json
VOZEB_PRO_PAYPLY_EXTRA_HEADERS=
VOZEB_PRO_PAYPLY_REQUEST_TEMPLATE=
VOZEB_PRO_PAYPLY_NOTIFY_URL=
VOZEB_PRO_PAYPLY_RETURN_URL=
VOZEB_PRO_PAYPLY_CANCEL_URL=
VOZEB_PRO_PAYPLY_RESULT_KIND=
VOZEB_PRO_PAYPLY_URL_FIELD=data.payUrl
VOZEB_PRO_PAYPLY_QR_FIELD=data.qrContent
VOZEB_PRO_PAYPLY_FORM_FIELD=data.formHtml
VOZEB_PRO_PAYPLY_PROVIDER_ORDER_ID_FIELD=data.tradeId
VOZEB_PRO_PAYPLY_PROVIDER_PAYMENT_ID_FIELD=data.paymentId
VOZEB_PRO_PAYPLY_WEBHOOK_SECRET=
VOZEB_PRO_PAYPLY_WEBHOOK_SIGNATURE_HEADER=x-signature
VOZEB_PRO_PAYPLY_WEBHOOK_EVENT_ID_FIELD=id
VOZEB_PRO_PAYPLY_WEBHOOK_EVENT_TYPE_FIELD=type
VOZEB_PRO_PAYPLY_WEBHOOK_ORDER_ID_FIELD=data.orderId
VOZEB_PRO_PAYPLY_WEBHOOK_ORDER_NO_FIELD=data.orderNo
VOZEB_PRO_PAYPLY_WEBHOOK_STATUS_FIELD=data.status
VOZEB_PRO_PAYPLY_WEBHOOK_SUCCESS_STATUSES=paid,success,succeeded,completed
VOZEB_PRO_PAYPLY_WEBHOOK_TRADE_ID_FIELD=data.tradeId
VOZEB_PRO_PAYPLY_WEBHOOK_PAYMENT_ID_FIELD=data.paymentId
VOZEB_PRO_PAYPLY_WEBHOOK_AMOUNT_CENTS_FIELD=data.amountCents
VOZEB_PRO_PAYPLY_WEBHOOK_AMOUNT_YUAN_FIELD=data.amount
VOZEB_PRO_PAYPLY_WEBHOOK_CURRENCY_FIELD=data.currency
VOZEB_PRO_PAYPLY_WEBHOOK_PAID_AT_FIELD=data.paidAt
VOZEB_PRO_PAYPLY_REFUND_REQUEST_METHOD=POST
VOZEB_PRO_PAYPLY_REFUND_CONTENT_TYPE=application/json
VOZEB_PRO_PAYPLY_REFUND_EXTRA_HEADERS=
VOZEB_PRO_PAYPLY_REFUND_REQUEST_TEMPLATE=
VOZEB_PRO_PAYPLY_REFUND_ID_FIELD=data.refundId
VOZEB_PRO_PAYPLY_REFUND_STATUS_FIELD=data.status
VOZEB_PRO_PAYPLY_REFUND_SUCCESS_STATUSES=refunded,success,succeeded

# Generic signed callback fallback for /api/billing/webhooks/custom.
VOZEB_PRO_PAYMENT_WEBHOOK_SECRET=
