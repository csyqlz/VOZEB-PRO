{
  "name": "vozeb-pro-docs",
  "version": "0.0.7",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3001",
    "start": "next start -p 3001",
    "generate:source": "node --input-type=module -e \"import { postInstall } from 'fumadocs-mdx/next'; await postInstall();\"",
    "types:check": "next typegen && npm run generate:source && tsc --noEmit",
    "postinstall": "npm run generate:source"
  },
  "dependencies": {
    "fumadocs-core": "16.15.11",
    "fumadocs-mdx": "15.4.1",
    "fumadocs-ui": "16.15.11",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zbsearch": "^3.3.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
