{
  "name": "vozeb-pro-docs",
  "version": "0.0.4",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3001",
    "start": "next start -p 3001",
    "generate:source": "node --input-type=module -e \"import { postInstall } from 'fumadocs-mdx/next'; await postInstall();\"",
    "types:check": "next typegen && npm run generate:source && tsc --noEmit",
    "postinstall": "npm run generate:source"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.1",
    "fumadocs-ui": "16.14.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
